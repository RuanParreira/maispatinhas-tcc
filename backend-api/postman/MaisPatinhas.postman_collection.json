      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Headers que o Sanctum exige em toda requisição (o Referer faz ele usar a sessão/cookie).",
          "const baseUrl = pm.collectionVariables.get('base_url');",
          "const frontendUrl = pm.collectionVariables.get('frontend_url');",
          "",
          "pm.request.headers.upsert({ key: 'Accept', value: 'application/json' });",
          "pm.request.headers.upsert({ key: 'Referer', value: frontendUrl });",
          "",
          "const token = pm.collectionVariables.get('xsrf_token');",
          "",
          "if (token) {",
          "    pm.request.headers.upsert({ key: 'X-XSRF-TOKEN', value: token });",
          "} else if (pm.request.method !== 'GET') {",
          "    // Ainda não tem token: busca o cookie CSRF antes de enviar a requisição.",
          "    pm.sendRequest({",
          "        url: baseUrl + '/sanctum/csrf-cookie',",
          "        method: 'GET',",
          "        header: { Accept: 'application/json', Referer: frontendUrl }",
          "    }, (err, res) => {",
          "        if (err) {",
          "            console.error('Falha ao buscar o token CSRF', err);",
          "            return;",
          "        }",
          "        const match = res.headers.all()",
          "            .filter(h => h.key.toLowerCase() === 'set-cookie')",
          "            .map(h => h.value.match(/XSRF-TOKEN=([^;]+)/))",
          "            .find(Boolean);",
          "        if (match) {",
          "            const fresh = decodeURIComponent(match[1]);",
          "            pm.collectionVariables.set('xsrf_token', fresh);",
          "            pm.request.headers.upsert({ key: 'X-XSRF-TOKEN', value: fresh });",
          "        }",
          "    });",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// O Laravel devolve um XSRF-TOKEN em toda resposta: guarda sempre o mais recente.",
          "const match = pm.response.headers.all()",
          "    .filter(h => h.key.toLowerCase() === 'set-cookie')",
          "    .map(h => h.value.match(/XSRF-TOKEN=([^;]+)/))",
          "    .find(Boolean);",
          "",
          "if (match) {",
          "    pm.collectionVariables.set('xsrf_token', decodeURIComponent(match[1]));",
          "}",
          "",
          "// 419 = token velho (sessão expirou). Apaga para o próximo envio buscar outro.",
          "if (pm.response.code === 419) {",
          "    pm.collectionVariables.unset('xsrf_token');",
          "    console.warn('Token CSRF expirado: envie de novo (e refaça o Login se der 401).');",
          "}"
        ]
      }
    }
  ],
